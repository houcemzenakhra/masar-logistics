{
  "name": "masar-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/scripts.ts migrate",
    "db:seed": "tsx src/server/scripts.ts seed",
    "db:seed:demo": "tsx src/server/scripts.ts seed-demo",
    "build:staging": "npm run db:migrate && npm run db:seed:demo && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
